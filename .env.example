# Bake the in-browser simulator into the bundle and skip the server probe.
# GitHub Pages sets this. Leave it unset locally so `npm run dev` uses the Node simulator.
# VITE_FORCE_BROWSER=true

# Optional absolute WebSocket URL. Defaults to the page host + /ws (Vite proxies /ws in dev).
# VITE_WS_URL=ws://127.0.0.1:8787/ws

# Port for the Node simulator.
# PORT=8787
